CM_ BU_ AK10_9 "Atuador direcao";
CM_ SG_ 81 ACU_STATE "";
CM_ BO_ 2147494248 "";
CM_ SG_ 2147494248 Position " ";
CM_ BO_ 1328 "IMU acceleration in the IMU frame, gravity included. Source: /imu/acceleration (geometry_msgs/Vector3Stamped)";
CM_ BO_ 1329 "IMU angular velocity in the IMU frame. Source: /imu/angular_velocity (geometry_msgs/Vector3Stamped)";
CM_ BO_ 1330 "GNSS position, WGS84. Source: /gnss_pose pose.position.x (latitude) and pose.position.y (longitude)";
CM_ BO_ 1331 "GNSS altitude. Source: /gnss_pose pose.position.z";
CM_ BO_ 1332 "Orientation quaternion. Source: /gnss_pose pose.orientation";
CM_ BO_ 1333 "Velocity in the IMU frame (X forward if the IMU is mounted aligned with the car). Source: /odometry twist.twist.linear (needs pub_odometry: true), or /filter/velocity (ENU) rotated into the IMU frame";
CM_ BO_ 1334 "Orientation as Euler angles, ENU reference (yaw 0 = East, positive counter-clockwise). Source: /filter/euler (geometry_msgs/Vector3Stamped), already in degrees";
CM_ BO_ 1335 "Xsens status word, same bit layout as the device so the raw 32-bit word can be copied in. Source: /status (xsens_mti_ros2_driver/XsStatusWord)";
CM_ BO_ 1336 "IMU temperature. Source: /temperature (sensor_msgs/Temperature)";
CM_ BO_ 1337 "Filter velocity exactly as published by the driver, ENU (X East, Y North, Z Up). Source: /filter/velocity (geometry_msgs/Vector3Stamped)";
CM_ BO_ 1338 "Free acceleration in the local earth frame (ENU), gravity removed. Source: /filter/free_acceleration (geometry_msgs/Vector3Stamped)";
CM_ SG_ 1329 Angular_Velocity_Z "Yaw rate";
CM_ SG_ 1333 Velocity_X "Longitudinal velocity";
CM_ SG_ 1333 Velocity_Y "Lateral velocity";
CM_ SG_ 1335 Filter_Valid "Set when the filter output (orientation, velocity, position) is valid";
CM_ SG_ 1335 GNSS_Fix "Set when the GNSS receiver has a position fix";
CM_ SG_ 1335 Clipping_Indication "Set when any accelerometer, gyroscope or magnetometer axis clipped";
VAL_ 81 IGN 0 "OFF" 1 "ON" ;
VAL_ 81 ASMS 0 "OFF" 1 "ON" ;
VAL_ 81 EMERGENCY 0 "OFF" 1 "ON" ;
VAL_ 81 AS_STATE 1 "OFF" 2 "READY" 3 "DRIVING" 4 "EMERGENCY" 5 "FINISH" ;
VAL_ 81 ACU_STATE 0 "INIT" 1 "MISSION_SELECT" 2 "JETSON_WAITING" 3 "INIT_SEQUENCE" 4 "READY" 5 "DRIVING" 6 "EBS_ERROR" 7 "EMERGENCY" 8 "FINISHED" 9 "MANUAL" ;
VAL_ 81 ASSI_STATE 1 "OFF" 2 "READY" 3 "DRIVING" 4 "EMERGENCY" 5 "FINISH" ;
VAL_ 81 EMERGENCY_cause 0 "None" 1 "SDC_OPEN" 2 "RES" 3 "Pressure_checks" 4 "VCU_timeout" 5 "Jetson_timeout" 6 "ACU_WDT_TRIGGERED" 7 "dir_actuator_timeout" 8 "CAN_Dynamics_Pressure_timeout" ;
VAL_ 2147494248 Error_Code 0 "None" 1 "OVER-VOLTAGE" 2 "UNDER-VOLTAGE" 3 "DRIVER-FAULT" 4 "OVER-CURRENT" 5 "MOSFET-OVER-TEMP" 6 "MOTOR-OVER-TEMP" 7 "GATE-DRIVE-OVER-VOLTAGE" 8 "GATE-DRIVE-UNDER-VOLTAGE" 9 "MCU-UNDER-VOLTAGE" 10 "REBOOTING-FROM-WATCHDOG" 11 "ENCODER-FAULT" 12 "MIN-ENCODER-LIMIT-EXCEEDED" 13 "MAX-ENCODER-LIMIT-EXCEEDED" 14 "FLASH-FAULT" 15 "HIGH-OFFSET-CURRENT-SENSOR1" 16 "HIGH-OFFSET-CURRENT-SENSOR2" ;
VAL_ 1282 AS_status 1 "AS_status_off" 2 "AS_status_ready" 3 "AS_status_driving" 4 "AS_status_emergency" 5 "AS_status_finished" ;
VAL_ 1282 ASB_EBS_state 1 "ASB_EBS_state_deactivated" 2 "ASB_EBS_state_initial_checkup_passed" 3 "ASB_EBS_state_activated" ;
VAL_ 1282 AMI_state 1 "AMI_state_acceleration" 2 "AMI_state_skidpad" 3 "AMI_state_trackdrive" 4 "AMI_state_braketest" 5 "AMI_state_inspection" 6 "AMI_state_autocross" ;
VAL_ 1282 ASB_redundancy_state 1 "ASB_redundancy_state_deactivated" 2 "ASB_redundancy_state_engaged" 3 "ASB_redundancy_state_initial_checkup_passed" ;
VAL_ 97 EMERGENCY_CAUSE 0 "None" 1 "RES" 2 "ACU" 3 "ZED" 4 "Steering_error" 5 "Steering_timeout" 6 "Planner" 7 "SLAM" 8 "P-Puma" 9 "IMU" ;
VAL_ 1335 RTK_Status 0 "No_RTK" 1 "RTK_Floating" 2 "RTK_Fixed" ;

